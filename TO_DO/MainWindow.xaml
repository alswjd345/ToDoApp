<Window x:Class="TO_DO.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TODO 앱" Height="520" Width="430"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">

    <Border Margin="24"
            Padding="24"
            Background="White"
            CornerRadius="18">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Margin="0,0,0,24">
                <TextBlock Text="오늘의 TODO"
                           FontSize="28"
                           FontWeight="Bold"
                           Foreground="#111827"/>

                <TextBlock Text="할 일을 추가하고 관리해보세요"
                           FontSize="13"
                           Foreground="#6B7280"
                           Margin="0,6,0,0"/>
            </StackPanel>

            <Border Grid.Row="1"
                    Background="#F9FAFB"
                    CornerRadius="12"
                    Padding="10"
                    Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="50"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TodoTextBox"
                             Height="38"
                             FontSize="14"
                             BorderThickness="0"
                             Background="Transparent"
                             VerticalContentAlignment="Center"
                             Padding="8"
                             Foreground="#111827"/>

                    <Button x:Name="SearchButton"
                            Grid.Column="2"
                            Content="검색"
                            Height="38"
                            Margin="8,0,0,0"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            Click="SearchButton_Click"/>
                    
                    <Button x:Name="AddButton"
                            Grid.Column="1"
                            Content="추가"
                            Height="38"
                            Margin="8,0,0,0"
                            Background="#2563EB"
                            Foreground="White"
                            BorderThickness="0"
                            FontWeight="Bold"
                            Click="add_data"/>
                </Grid>
            </Border>

            <ListBox x:Name="TodoListBox"
                     Grid.Row="2"
                     BorderThickness="0"
                     Background="#F9FAFB"
                     Padding="8"
                     FontSize="14"/>

            <Button x:Name="DeleteButton"
                    Grid.Row="3"
                    Content="선택한 할 일 삭제"
                    Height="40"
                    Margin="0,18,0,0"
                    Background="#EF4444"
                    Foreground="White"
                    BorderThickness="0"
                    FontWeight="Bold"
                    Click="DeleteButton_Click"
                    />
        </Grid>
    </Border>
</Window>