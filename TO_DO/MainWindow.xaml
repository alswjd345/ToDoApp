<Window x:Class="TO_DO.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="TODO 앱" Height="550" Width="500"
        WindowStartupLocation="CenterScreen"
        Background="#F3F4F6">

    <Border Margin="24"
            Padding="24"
            Background="White"
            CornerRadius="18">

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="1*"/>
                <RowDefinition Height="Auto"/>
                
            </Grid.RowDefinitions>

            <Grid>
                <TextBlock Text="오늘의 TODO" FontSize="28" FontWeight="Bold"  Foreground="#111827"/>
                <StackPanel HorizontalAlignment="Right">
                    <TextBlock x:Name="alllistCount" FontSize="10" Foreground="#6B7280"  Margin="6,6,6,0"/>
                    <TextBlock x:Name="process"    FontSize="10" Foreground="#6B7280"  Margin="6,6,6,0"/>
                    <TextBlock x:Name="complete"  FontSize="10" Foreground="#6B7280"  Margin="6,6,6,0"/>
                </StackPanel>    
            </Grid>
            
            

            <Border Grid.Row="1"
                    Background="#F9FAFB"
                    CornerRadius="12"
                    Padding="10"
                    Margin="0,0,0,18">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="55"/>
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="TodoTextBox"  Height="38"  FontSize="14"  BorderThickness="0"   Background="Transparent"  VerticalContentAlignment="Center"
                             Padding="8"  Foreground="#111827"/>

                    <Button x:Name="SearchButton" Grid.Column="1"  Content="검색"   Height="38"  Margin="8,0,0,0"    Background="#2563EB"  Foreground="White"
                            BorderThickness="0"   FontWeight="Bold"  Click="SearchButton_Click"/>
                    
                    <Button x:Name="AddButton" Grid.Column="2"    Content="추가" Height="38"   Margin="8,0,0,0" Background="#2563EB"  Foreground="White"
                            BorderThickness="0"  FontWeight="Bold"  Click="add_data"/>
                    
                    <Button x:Name="AllSearchButton" Grid.Column="3"  Content="전체보기"  Height="38"  Margin="8,0,0,0"  Background="#2563EB"   Foreground="White"
                            BorderThickness="0"  FontWeight="Bold"  Click="AllSearchButton_Click"/>
                </Grid>
            </Border>

            <Grid Grid.Row="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <ListBox x:Name="TodoListBox" BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" >
                                <CheckBox Grid.Column="0" IsChecked="{Binding Ischecked}" Checked="CheckBox_Checked" Unchecked="CheckBoxUnChecked" Margin="0,0,10,0" />
                                <TextBox  Text="{Binding Title}" Visibility="{Binding Editing}"  BorderThickness="0" Width="300" IsReadOnly="True" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" Content="수정" Width="50" Background="Gray" Foreground="White" BorderThickness="0"  Click="EditOrSave_Click" />
                        </StackPanel>

                    </DataTemplate>
                </ListBox.ItemTemplate>
                    
            </ListBox>
            </Grid>

            <Button x:Name="DeleteButton" Grid.Row="3" Content="선택한 할 일 삭제"  Height="40"  Margin="0,18,0,0" Background="#EF4444"  Foreground="White" 
                    BorderThickness="0"  FontWeight="Bold" Click="DeleteButton_Click"
                    />
        </Grid>
    </Border>

</Window>